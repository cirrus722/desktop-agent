# 复制为 .env 并填入你自己的值。仓库里只有 key 名，没有值。

# LLM 提供方：anthropic | openai | mock（mock 无需 Key，用于本地联调）
LLM_PROVIDER=openai

# OpenAI 兼容接口（DeepSeek / Qwen / Moonshot 等都兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Anthropic 官方接口时使用
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514

LLM_API_KEY=sk-xxx

# 智能体护栏
AGENT_MAX_STEPS=15
BASH_DEFAULT_TIMEOUT=30

# 增量能力开关：设为 0 时退回 v1.0 行为
ENABLE_SKILLS=1
ENABLE_HOOKS=1

# 可选：覆盖 PostToolUse 自动测试命令；不填则自动发现 test_*.py / tests/
# AGENT_TEST_CMD=python -m pytest -q
